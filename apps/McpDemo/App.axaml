<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Six.Avalonia.Mcp.App.App"
             xmlns:mcp="clr-namespace:Six.Avalonia.Mcp.App"
             RequestedThemeVariant="Dark">

	<Application.DataTemplates>
		<mcp:ViewLocator />
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme />
	</Application.Styles>
</Application>